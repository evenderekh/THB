# Builder output — regenerated by thb_builder.py
public_html/sitemap.xml
public_html/index.html
public_html/pagefind/
public_html/*/

# Keep static assets
!public_html/static/
!public_html/about/
!public_html/license/
!public_html/privacy/
!public_html/terms/
!public_html/search/

# Stray asset copies that don't belong in page directories
